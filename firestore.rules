rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(circleId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/circles/$(circleId)).data.memberUids;
    }
    function isMemberAfter(circleId) {
      return signedIn() && request.auth.uid in
        getAfter(/databases/$(database)/documents/circles/$(circleId)).data.memberUids;
    }
    function isOwner(circleId) {
      return signedIn() && request.auth.uid ==
        get(/databases/$(database)/documents/circles/$(circleId)).data.ownerUid;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    match /circles/{circleId} {
      allow read: if signedIn() &&
        request.auth.uid in resource.data.memberUids;
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerUid;
      allow update: if isMember(circleId);
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

      match /members/{uid} {
        allow read: if isMember(circleId);
        allow create: if signedIn() && request.auth.uid == uid &&
          (isMember(circleId) || isMemberAfter(circleId));
        allow update: if isMember(circleId) && request.auth.uid == uid;
        allow delete: if isMember(circleId) &&
          (request.auth.uid == uid || isOwner(circleId));
      }

      match /messages/{messageId} {
        allow read, write: if isMember(circleId);
      }
    }
  }
}
